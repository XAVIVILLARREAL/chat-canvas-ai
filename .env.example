# Canvas AI — variables de entorno (copiar a .env, NUNCA commitear .env)

# ─── Provider de pruebas GRATIS (recomendado para desarrollo/tests) ─────────
# OpenRouter ofrece modelos gratuitos (sufijo :free), p.ej. ox-alpha free de
# opencode. Con esta key los tests E2E/humanos con LLM real cuestan $0.
# Setup: https://openrouter.ai → Keys → crear key (empieza con sk-or-)
OPENROUTER_API_KEY=sk-or-v1-TU-KEY-AQUI

# Modelo free por defecto para pruebas (ox-alpha — gratis, ctx 1M; slug verificado 2026-08-25)
CANVAS_TEST_MODEL=stealth/ox-alpha

# ─── Gateway Rust (dev) ─────────────────────────────────────────────────────
# El server escucha aquí; el proxy de Vite enruta /api → este origen
# CANVAS_SERVER_URL=http://127.0.0.1:3030

# Frontend: base de la API (en dev el proxy la resuelve; en nube apunta al gateway)
# VITE_API_BASE=/api

# ─── Modo nube (solo si despliegas el stack servidor) ──────────────────────
# DATABASE_URL=postgres://canvas:pass@localhost:5432/canvas_ai
# KEK_MASTER=base64-32-bytes        # KEK maestra para vault BYOK por tenant (THREAT-MODEL)
