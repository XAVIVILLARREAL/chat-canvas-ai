{
  "name": "empresa-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --port 1420",
    "build": "tauri build",
    "build:frontend": "vite build",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:oxc": "oxlint src/",
    "lint:dead": "knip",
    "format": "biome format --write src/",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:human": "npx playwright test --config=e2e/playwright.human.config.ts",
    "test:e2e:human:core": "npx playwright test --config=e2e/playwright.human.config.ts --grep @core",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:chromium": "npx playwright test --config=e2e/playwright.config.ts --project=chromium",
    "test:e2e:webkit": "npx playwright test --config=e2e/playwright.config.ts --project=webkit",
    "typecheck": "tsgo --noEmit",
    "check:all": "pnpm typecheck && pnpm lint && pnpm lint:oxc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.0",
    "knip": "6.32.2",
    "oxc-transform-react": "0.145.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  }
}
